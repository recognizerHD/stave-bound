<?xml version="1.0" encoding="utf-8"?>
<!--
  Imported by Microsoft.Common.props *before* NuGet's generated props, which is the
  point of this file. Jotunn's build/Paths.props imports Environment.props, derives
  BEPINEX_PATH and VALHEIM_MANAGED from VALHEIM_INSTALL, and resolves every
  game/BepInEx <Reference> HintPath from them — all at evaluation time. Anything it
  depends on has to be set before NuGet's props are imported; setting it later in the
  .csproj is too late and yields references pointing at a guessed Steam path.

  What it depends on here is SolutionDir, because Paths.props reaches Environment.props
  and DoPrebuild.props through it and MSBuild only defines it for .sln builds. Setting
  it below is therefore what makes `dotnet build Stavebound/Stavebound.csproj` behave the
  same as building the solution.

  Note what this file deliberately does *not* do: import Environment.props itself.
  Paths.props already does, on its first line, so a second import here changes no value
  and only earns an MSB4011 "cannot be imported again" on every single build.
-->
<Project>

  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>recognizerHD</Authors>
    <Copyright>Copyright (c) 2026 recognizerHD</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/recognizerHD/stave-bound</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    Fail with something readable instead of ~90 "assembly not found" errors when the
    game path is missing or wrong.
  -->
  <Target Name="StaveboundCheckValheimPath" BeforeTargets="BeforeBuild">
    <Error Condition="'$(VALHEIM_INSTALL)' == '' Or !Exists('$(VALHEIM_INSTALL)')"
           Text="VALHEIM_INSTALL is not set to an existing folder (currently: '$(VALHEIM_INSTALL)'). Copy Environment.props.example to Environment.props and set your Valheim install path, or set VALHEIM_INSTALL as an environment variable. See README.md." />
    <Error Condition="'$(VALHEIM_MANAGED)' == '' Or !Exists('$(VALHEIM_MANAGED)')"
           Text="Could not find the game's Managed folder under '$(VALHEIM_INSTALL)' (looked for Valheim_Data/Managed and valheim_Data/Managed). Check that VALHEIM_INSTALL points at the folder containing valheim.exe." />
    <Error Condition="!Exists('$(BEPINEX_PATH)/core/BepInEx.dll')"
           Text="BepInEx is not installed in '$(BEPINEX_PATH)'. Install BepInEx 5 into your Valheim folder and run the game once before building." />
  </Target>

</Project>
