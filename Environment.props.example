<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to "Environment.props" (same folder) and point VALHEIM_INSTALL at
  your own Valheim install. "Environment.props" is gitignored on purpose: it is a
  machine-local path, and nothing under your game folder may be committed.

  You can skip this file entirely by setting VALHEIM_INSTALL as an environment
  variable instead — MSBuild reads environment variables as properties, and that
  is the route CLAUDE.md prescribes.

  Jotunn's build props derive BEPINEX_PATH and VALHEIM_MANAGED from VALHEIM_INSTALL,
  so this is normally the only path you need to set.
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Windows -->
    <VALHEIM_INSTALL>C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>

    <!-- Linux -->
    <!-- <VALHEIM_INSTALL>$(HOME)/.steam/steam/steamapps/common/Valheim</VALHEIM_INSTALL> -->

    <!-- macOS -->
    <!-- <VALHEIM_INSTALL>$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim/Contents/MacOS</VALHEIM_INSTALL> -->

    <!--
      Optional. If set, a successful build copies Stavebound.dll straight into your plugins
      folder, creating it if needed. Leave it unset to build without deploying.
    -->
    <MOD_DEPLOYPATH>$(VALHEIM_INSTALL)\BepInEx\plugins\Stavebound</MOD_DEPLOYPATH>

    <!--
      If you launch through r2modman or Thunderstore Mod Manager, deploy into the profile
      instead. Those launch the game with Doorstop pointed at the profile's own BepInEx, so
      the copy in the game folder is never loaded and you will spend an evening wondering why
      your changes do nothing. Replace the profile name with yours.
    -->
    <!--
    <MOD_DEPLOYPATH>$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default\BepInEx\plugins\Stavebound</MOD_DEPLOYPATH>
    -->
  </PropertyGroup>
</Project>
